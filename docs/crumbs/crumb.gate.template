# tests/gates/crumb.gate (template; ADR 0033 amendment 2026-10-11, lane CRUMB)
# The always-run crumb check of every enrolled repository. Manifest v2 grammar
# (ARCH-0028 Decision 3 plus ARCH-0033 Decision 2). Copy to tests/gates/crumb.gate,
# set `owner` to the repository name, and list under `inputs` the ".crumb" entry
# plus the repository-root directories the repository chooses to bind (every
# directory that holds compiled crumbs). The REPOS lane commits per-repo copies;
# this file itself is not a gate (it lives under docs/, not tests/gates/).
#
# Recorded limit (measured 2026-10-11): aien-test parses `run.exec: crumb` and
# `aien-test list` shows the gate, but today's runner resolves run.exec as
# <repo-root>/crumb, so execution needs either the engine to resolve bare names
# on PATH (ENGINE lane) or a one-line in-repo wrapper such as
# tools/crumb-verify.sh that execs `crumb verify .`.
gate: CRUMB-VERIFY
manifest_version: 2
owner: aien-architecture
exactness: EXACT
requires:
  - portable
inputs:
  - .crumb
  - docs/
  - doctrine/
  - scripts/
  - tools/
run:
  exec: crumb
  args: ["verify", "."]
expects:
  exit: 0
  verdict: PASS
cache_scope: portable
timeout: 5m

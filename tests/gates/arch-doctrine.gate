# tests/gates/arch-doctrine.gate
# Mirrors hosted: repository script scripts/check_doctrine.sh (not a hosted job; doctrine consistency, always-run)
gate: ARCH-DOCTRINE
manifest_version: 2
owner: aien-architecture
requires:
  - portable
inputs:
  - scripts/check_doctrine.sh
  - doctrine/
  - docs/
  - CURRENT_EXECUTION_PLAN.md
  - PLAN_AUTHORITY.md
  - tests/gates/
run:
  exec: tests/gates/run.sh
  args: ["doctrine"]
expects:
  exit: 0
  verdict: PASS
timeout: 5m
exactness: EXACT
cache_scope: portable

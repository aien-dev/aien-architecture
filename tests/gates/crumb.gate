# tests/gates/crumb.gate
# Mirrors hosted: crumb.yml 'Crumbs must be exactly what the compiler produces now' (./tools/crumb/crumb verify .)
# cache: never because crumbs live in many directories and inputs are literal paths; the check is sub-second.
gate: CRUMB-VERIFY
manifest_version: 2
owner: aien-architecture
requires:
  - portable
inputs:
  - .crumb
  - tools/crumb/
  - tests/gates/
run:
  exec: tests/gates/run.sh
  args: ["crumb-verify"]
expects:
  exit: 0
  verdict: PASS
timeout: 5m
exactness: EXACT
cache_scope: portable
cache: never
